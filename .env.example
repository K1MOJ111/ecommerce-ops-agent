APP_ENV=development
# Explicit local providers; production rejects either fake provider.
AGENT_PROVIDER=openai_compatible
EMBEDDING_PROVIDER=openai_compatible
# Development defaults to localhost/127.0.0.1:5173; production defaults to no CORS.
# CORS_ORIGINS=["https://ops.example.com"]
# Optional local fixed identity, never accepted from HTTP. Leave unset for default 401.
# DEV_ACTOR_ID=<existing-local-user-uuid>
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=example-local-only
POSTGRES_DB=ecommerce_ops
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://ecommerce:example-local-only@127.0.0.1:55432/ecommerce_ops

# Optional live model; automated Agent tests use a Fake Model.
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
EMBEDDING_BASE_URL=https://example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_TIMEOUT_SECONDS=30
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_MIN_SIMILARITY=0.2
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_GRAPH_STEPS=24
AGENT_TIMEOUT_SECONDS=90
RAG_TOP_K=5

# Set explicitly when running integration tests. Do not point at business data.
# TEST_DATABASE_URL=postgresql+asyncpg://ecommerce:example-local-only@127.0.0.1:55432/ecommerce_ops_test
